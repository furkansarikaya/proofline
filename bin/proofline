#!/bin/sh
# proofline CLI (D8, D23). POSIX sh. Installs and checks the control plane (init, upgrade, doctor), shows
# state (status, resume, queue) and tells you the exact instruction for your agent session for the commands
# that need one (task, design, run, review, audit, debug, deliver). It never commits, pushes or approves;
# its one merge path is `merge`, which merges a pull request only when every check is green (A136), on GitHub, GitLab and
# Azure DevOps through gh, glab or az (A180); on any other platform the user merges.
#   proofline help
# shellcheck source-path=SCRIPTDIR
set -u
PROOFLINE_VERSION=0.0.40

# Resolve this script through symlinks (no readlink -f: BSD has none) to find the proofline checkout.
self=$0
case "$self" in */*) ;; *) self=$(command -v "$self" 2>/dev/null || echo "$self") ;; esac
while [ -L "$self" ]; do
  l=$(readlink "$self")
  case "$l" in /*) self=$l ;; *) self=$(dirname "$self")/$l ;; esac
done
PL_HOME=$(CDPATH='' cd "$(dirname "$self")/.." && pwd) || exit 1
LIB=$PL_HOME/bin/lib

say() { printf '%s\n' "$*"; }
warn() { printf 'proofline: %s\n' "$*" >&2; }
# nu_line [--error[=KIND]]: the user's next step (A159), from the one table in next-user.sh, for the command being run.
PL_CMD=''; PL_ID=''; PL_KIND=''
nu_line() { PROOFLINE_ROOT=$ROOT sh "$PL_HOME/control-plane/agents/scripts/next-user.sh" "${PL_CMD:-help}" ${PL_ID:+"$PL_ID"} "$@"; }
die() { printf 'proofline: %s\n' "$*" >&2; nu_line "--error${PL_KIND:+=$PL_KIND}" >&2 || :; exit 1; }
if command -v shasum >/dev/null 2>&1; then sha256() { shasum -a 256 "$1" | awk '{print $1}'; }
else sha256() { sha256sum "$1" | awk '{print $1}'; }; fi

# shellcheck source=lib/config.sh
. "$LIB/config.sh"
# shellcheck source=lib/discover.sh
. "$LIB/discover.sh"
# shellcheck source=lib/install.sh
. "$LIB/install.sh"
# shellcheck source=lib/commands.sh
. "$LIB/commands.sh"
# shellcheck source=lib/timeouts.sh
. "$LIB/timeouts.sh"
# shellcheck source=lib/doctor.sh
. "$LIB/doctor.sh"
# shellcheck source=lib/insights.sh
. "$LIB/insights.sh"
# shellcheck source=lib/merge.sh
. "$LIB/merge.sh"

ROOT=$(git rev-parse --show-toplevel 2>/dev/null) || ROOT=$PWD
CFG=$ROOT/.agents/config.yaml
A=$ROOT/.agents/scripts/agent.sh

usage() {
  cat <<'EOF'
proofline: a deterministic engineering team for coding agents

usage: proofline <command> [args]

setup
  init [flags]            install the control plane, agents, skills and hooks into this git repository
                            --yes  --dry-run  --runtimes claude,codex  --lead R  --worker R  --reviewers R
                            --profile max|balanced|economy  --task-adapter markdown|github|jira|linear
                            --protected-branches "a b"  --push-approval true|false
                            --forbidden-identity PATTERN (repeatable)  --verify-commands
                            --role ROLE=RUNTIME (repeatable)  run one role on another runtime
  upgrade [--dry-run]     update unmodified control-plane files; keep yours and report conflicts
  doctor                  verify hooks, runtimes, config, commit identity and every enforced rule (live probes)
                            --scale  measure this machine and propose timeouts.scale; --apply-scale writes it after your "approve scale"
                            --commands  find, prove by one run and propose the empty commands.build|test|lint (one question)
                            --apply-commands  write the proven proposal after your yes
  version

state (works without an agent session)
  status                  active run and its next step (default command)
  resume                  run state, ledger tail, freshness and the next step after a pause or runtime switch
  queue                   task files and runs
  deliver <TASK>          delivery check and what delivery will do (never commits): knowledge, commit, push, PR, merge
                            when green, cleanup, after one "approve delivery"; a FAILED or BLOCKED run is refused (reopen it first)
  debt                    list the shortcut comments in the code (`shortcut: <limit>, <when to improve>`) with
                            file:line, limit and improvement condition; read-only, needs no run
  clean [--yes]           remove .agents/local state and finished runs
  merge <PR> [--merge|--squash|--rebase] [--delete-branch] [-R OWNER/REPO]
                          the only allowed merge path: checks that every check of the pull request is
                            green on its current head, then merges (--admin and --auto are refused).
                            GitHub (gh), GitLab (glab) and Azure DevOps (az repos) when the tool is installed;
                            a pull request without any check is merged only after build and test pass in a
                            clean copy of its commit ("verified locally, no CI"). Bitbucket, other hosts and a
                            missing tool: nothing is merged here, the link and steps are printed, YOU merge
  insights [--run ID] [--json]
                          read-only report: cost per run, role and model (tokens only where the runtime
                            reported them) and recurring failures with suggestions; changes nothing

agent session (prints the exact instruction for your runtime)
  task [--grill] <text>   write a task file (grill the intent first with --grill)
  design system|data|api|ui [--check]
  (design documents: design_docs.design in .agents/config.yaml is one path, or one document per UI surface; see docs/concepts/design-surfaces.md)
  design ui <mode> <target>  focused UI change of one target, as a normal run; mode: bolder quieter polish animate typeset
                            colorize layout delight harden adapt (touches only the target, keeps the existing design system)
  docs create|update|audit  write, update from a diff, or audit documentation
  explain <topic|TASK-ID>  one self-contained offline HTML page that explains a topic or a task
  run <TASK>              take a task through the full workflow
  review | audit | debug  proof-review, test-trust and debug-proof standalone
  wiki ingest|query|lint  keep a persistent project wiki in docs/wiki/
  knowledge <TASK>        knowledge step of a finished run: wiki, ADRs, lesson candidates; deliver runs it when missing
  product prd|review|split <slug>
                          write a product requirements document with you, review it on its own, split it into tasks
  product discover frame|research|interviews|competitors|opportunities <slug>
                          frame, research, interview, compare competitors and rank opportunities with sources (before a PRD)
  product assess assumptions|probes|premortem|redteam|decision <slug>
                          test assumptions with locked probes, a premortem, a red team and a build, clarify or stop decision
  product outcome <slug>
                          record the measured outcome of a shipped change against its baseline
  trace <FR-n|TASK-ID>    follow a requirement or task to its tests, run evidence and pull request, and the evidence, assumption, decision and outcome behind it (read-only)
  reopen <TASK>           take a FAILED or BLOCKED run back into the workflow, only with your approval
  batch <ID...|all>       night mode, in this session: one summary and one "approve batch" stand in for the plan and delivery
                            approvals of the listed tasks (no CRITICAL task; nothing else is covered; a project without CI gets a
                            warning: each pull request is then verified locally before it merges). The lead runs each task and
                            delivers it, in dependency order, and starts the next one only when the previous is merged; a stuck task is
                            parked, its dependents are skipped, independent tasks go on. Keep the computer awake and the session
                            open (on macOS the session offers caffeinate for exactly its own lifetime); after an interruption
                            /proofline batch continues the approved batch and never runs a merged task again.
                            batch status: the morning table, from records only
EOF
}

installed() { [ -f "$CFG" ] && [ -f "$A" ]; }
require_installed() { installed || die "proofline is not installed in $ROOT (.agents/config.yaml missing); run: proofline init"; }
agent() { (cd "$ROOT" && sh "$A" "$@"); }
active_id() { agent status 2>/dev/null | sed -n 's/^active_task=//p' | head -1; }
tasks_dir() { cfg_val "$CFG" tasks.dir .agents/tasks; }

# hint ARGS...: the instruction for the lead's session, for the configured lead runtime.
hint() {
  rt=$(cfg_val "$CFG" runtime.lead claude)
  say ""
  case "$rt" in
    codex)
      say "This step needs an agent session (lead runtime: codex). In your Codex session say:"
      # shellcheck disable=SC2016
      printf '  $proofline %s\n' "$*"
      say "or start one:"
      printf "  codex '\$proofline %s'\n" "$*" ;;
    *)
      say "This step needs an agent session (lead runtime: $rt). In your Claude Code session say:"
      printf '  /proofline %s\n' "$*" ;;
  esac
  say "Any other agent that reads AGENTS.md: ask it to follow .agents/skills/proofline-lead/SKILL.md for: $*"
}

cmd_status() {
  require_installed
  agent status | sed -n '1,4p'
  id=$(active_id)
  case "$id" in
    ''|none) say "no active run. Queue: proofline queue; start: proofline run <TASK>" ;;
    *) say ""; agent next "$id" | grep -v '^next=' ;;
  esac
}

cmd_resume() {
  require_installed
  id=$(active_id)
  case "$id" in
    ''|none) say "no active run to resume. Queue: proofline queue"; hint run "<TASK>"; return 0 ;;
  esac
  say "run $id"
  agent next "$id" | grep -v '^next=' || die "cannot read the state of run $id (is .agents/runs/$id intact?)"
  led=$ROOT/.agents/runs/$id/LEDGER.log
  if [ -f "$led" ]; then say ""; say "ledger (last 5 rows):"; tail -n 5 "$led" | sed 's/^/  /'; fi
  say ""
  for chk in freshness verify-handoff; do
    if out=$(agent "$chk" "$id" 2>&1); then say "$chk: ok"
    else say "$chk: FAILED ($(printf '%s' "$out" | tail -n 1)); the lead re-checks this before trusting persisted work"; fi
  done
  say "An interrupted step restarts from its beginning; persisted work is trusted only after both checks pass."
  hint resume
}

cmd_queue() {
  require_installed
  td=$ROOT/$(tasks_dir)
  say "tasks ($(tasks_dir)):"
  found=0
  for d in todo backlog; do
    for f in "$td/$d"/*.md; do [ -f "$f" ] || continue; say "  $d/$(basename "$f")"; found=1; done
  done
  for f in "$td"/*.md; do [ -f "$f" ] || continue; say "  $(basename "$f")"; found=1; done
  [ "$found" = 1 ] || say "  (none)"
  # A202: finished tasks show their title and status only (the first lines of the file); the completion report stays in the file as evidence and is never read here.
  dn=0
  for f in "$td"/done/*.md; do
    [ -f "$f" ] || continue
    dn=$((dn + 1)); [ "$dn" -le 20 ] || continue
    [ "$dn" -gt 1 ] || say "done (title and status only):"
    dh=$(head -n 12 "$f"); dt=$(printf '%s\n' "$dh" | sed -n '1s/^# *//p'); ds=$(printf '%s\n' "$dh" | sed -n 's/^\*\*Status:\*\* *//p' | head -n 1)
    say "  done/$(basename "$f"): ${dt:-(no title)} [${ds:--}]"
  done
  [ "$dn" -le 20 ] || say "  ... and $((dn - 20)) more finished task(s)"
  act=$(active_id); say "runs (.agents/runs):"
  found=0
  for r in "$ROOT"/.agents/runs/*/ "$ROOT"/.agents/local/worktrees/*/.agents/runs/*/; do
    [ -d "$r" ] || continue; rid=$(basename "$r"); found=1
    st=$(agent next "$rid" 2>/dev/null | sed -n 's/^state=//p; s/^handoff=/ handoff=/p' | tr '\n' ' ')
    if [ "$rid" = "$act" ]; then mark='*'; else mark=' '; fi
    wtm=''; case "$r" in "$ROOT"/.agents/local/worktrees/*) wtm=" (worktree .agents/local/worktrees/$rid)" ;; esac   # A169
    say " $mark $rid  ${st:-state unknown}$wtm"
  done
  [ "$found" = 1 ] || say "  (none)"
  say "(* = active run)"
}

cmd_debt() {
  require_installed
  agent debt
}

cmd_deliver() {
  require_installed
  id=${1:-}; [ -n "$id" ] || die "usage: proofline deliver <TASK>"
  # A152: a FAILED or BLOCKED run is not delivered (no draft pull request); reopening it is the user's call.
  st=$(agent next "$id" 2>/dev/null | sed -n 's/^state=//p')
  case "$st" in FAILED|BLOCKED) say "delivery refused: $id is $st; to reopen: /proofline reopen $id" >&2; return 1 ;; esac
  if ! out=$(agent delivery-check "$id" 2>&1); then
    case $out in
      *"knowledge step"*)
        # A152: an unfinished knowledge step is part of the delivery, not a stop: the one summary lists what it changed.
        say "knowledge step not done yet: the lead runs it as part of this delivery (/proofline knowledge $id), then asks once."
        hint deliver "$id"; return 0 ;;
    esac
    printf '%s\n' "$out" >&2
    say "not deliverable yet; nothing was committed. The lead continues the run until every required gate passes."
    hint deliver "$id"; return 1
  fi
  printf '%s\n' "$out"
  br=$(git -C "$ROOT" branch --show-current 2>/dev/null)
  n=$(git -C "$ROOT" status --porcelain --untracked-files=all 2>/dev/null | grep -vc ' \.agents/\(runs\|local\)/' || true)
  say ""
  say "what delivery would do (proofline never commits by itself):"
  say "  commit : $n changed path(s) on branch $br, message format $(cfg_val "$CFG" git.commit_format conventional), identity $(git -C "$ROOT" var GIT_AUTHOR_IDENT 2>/dev/null | sed 's/ [0-9]* [-+][0-9]*$//')"
  say "  push   : remote(s): $(git -C "$ROOT" remote 2>/dev/null | tr '\n' ' ')"
  say "  pr     : a pull request with the completion report as its body (Bitbucket or another host, or no gh/glab/az: the branch is pushed, the link is printed and you merge)"
  say "  merge  : only when every check is green, through 'proofline merge'; a red check stops before cleanup; without any check the build and test run in a clean copy first"
  say "  cleanup: after the merge"
  say "  one approval: the lead shows one summary; your reply \"approve delivery\" approves each step of it, bound to this content"
  say "  never  : tag, force-push, touch a protected branch (configured: $(cfg_val "$CFG" git.protected_branches none))"
  hint deliver "$id"
}

confirm() { # PROMPT -> 0 when the user types y/yes on a terminal
  [ -t 0 ] || return 1
  printf '%s [y/N]: ' "$1" >&2; IFS= read -r c || return 1
  case "$c" in y|Y|yes|YES) return 0 ;; esac; return 1
}

cmd_clean() {
  require_installed
  yes=0; [ "${1:-}" = --yes ] && yes=1
  act=$(active_id); fin=''
  for r in "$ROOT"/.agents/runs/*/; do
    [ -d "$r" ] || continue; rid=$(basename "$r")
    nx=$(agent next "$rid" 2>/dev/null) || continue
    case "$(printf '%s\n' "$nx" | sed -n 's/^state=//p')" in FAILED|BLOCKED) fin="$fin $rid"; continue ;; esac
    [ "$(printf '%s\n' "$nx" | sed -n 's/^handoff=//p')" = DONE ] && fin="$fin $rid"
  done
  lf=0; [ ! -d "$ROOT/.agents/local" ] || lf=$(find "$ROOT/.agents/local" -type f ! -name ACTIVE_RUN ! -path "$ROOT/.agents/local/worktrees/*" | wc -l | tr -d ' ')
  say "clean would remove:"
  say "  .agents/local state: $lf file(s) (the ACTIVE_RUN selector is kept unless its run is cleaned)"
  say "  finished runs:${fin:- none}"
  if [ "$lf" = 0 ] && [ -z "$fin" ]; then say "nothing to clean"; return 0; fi
  if [ "$yes" != 1 ] && ! confirm "remove these?"; then die "refusing to remove anything without --yes (or a yes at the prompt)"; fi
  [ ! -d "$ROOT/.agents/local" ] || find "$ROOT/.agents/local" -mindepth 1 ! -name ACTIVE_RUN ! -path "$ROOT/.agents/local/worktrees" ! -path "$ROOT/.agents/local/worktrees/*" -delete 2>/dev/null   # A169: run worktrees hold parked runs' evidence: agent.sh worktree-remove, never clean
  for rid in $fin; do agent cleanup "$rid" || warn "run $rid was not cleaned (agent.sh refused)"; done
  [ -z "$act" ] || [ "$act" = none ] || say "active run $act kept unless it was finished"
}

cmd_task() {
  require_installed
  grill=''; [ "${1:-}" = --grill ] && { grill='--grill '; shift; }
  [ $# -gt 0 ] || die "usage: proofline task [--grill] <text>"
  say "task file goes to $(tasks_dir)/ through the $(cfg_val "$CFG" tasks.adapter markdown) adapter; no run starts."
  hint task "$grill$*"
}

cmd_design() {
  require_installed
  case "${1:-}" in system|data|api|ui) ;; *) die "usage: proofline design system|data|api|ui [--check] | design ui <mode> <target>" ;; esac
  if [ "$1" = ui ] && [ $# -gt 1 ] && [ "$2" != --check ]; then
    case "$2" in bolder|quieter|polish|animate|typeset|colorize|layout|delight|harden|adapt) ;;
      *) die "unknown design ui mode: $2 (want bolder|quieter|polish|animate|typeset|colorize|layout|delight|harden|adapt)" ;; esac
    [ $# -ge 3 ] || die "usage: proofline design ui $2 <target>  (the page, section or component to change)"
    say "focused UI change: mode $2, only the target; it is a normal run (TRIVIAL or STANDARD) and the target is checked afterwards."
    hint design "$@"
    return 0
  fi
  dd_sf=$(cfg_lines "$CFG" 2>/dev/null | sed -n 's/^design_docs\.design\.surfaces\.\([^.=]*\)\.doc=\(.*\)$/\1=\2/p' | tr '\n' ' ' | sed 's/ $//')
  if [ -n "$dd_sf" ]; then dd_main="surfaces: $dd_sf; shared: $(cfg_val "$CFG" design_docs.design.shared none)"; else dd_main=$(cfg_val "$CFG" design_docs.design docs/design/DESIGN.md); fi
  say "durable design documents: $dd_main, $(cfg_val "$CFG" design_docs.architecture ''), $(cfg_val "$CFG" design_docs.data_model ''), $(cfg_val "$CFG" design_docs.api '')"
  hint design "$@"
}

cmd_run() {
  require_installed
  [ -n "${1:-}" ] || die "usage: proofline run <TASK>"
  act=$(active_id)
  case "$act" in ''|none) ;; "$1") say "run $1 is already active; resuming it is: proofline resume" ;; *) warn "run $act is active; one active run per worktree: finish or clean it first" ;; esac
  hint run "$@"
}

cmd_batch() { # A157: night mode. The plan and the tasks run in the agent session; status needs none
  require_installed
  case "${1:-}" in
    status) agent batch-status ;;
    run|stop) die "proofline batch $1 is gone (removed in 0.0.32): night mode runs in your agent session, not in a background driver. Plan it with /proofline batch <ID...|all>, reply \"approve batch\", and continue an interrupted batch with /proofline batch in the session; proofline batch status shows the table" ;;
    '') hint batch ;;
    *) say "night mode runs in the lead's session: one summary, one \"approve batch\", then the lead runs and delivers the tasks one after the other; keep the computer awake and the session open"
       hint batch "$@" ;;
  esac
}

cmd_session() { # review | audit | debug | docs | explain | wiki | product | trace
  c=$1
  case "$c" in
    docs) case "${2:-}" in create|update|audit) ;; *) die "usage: proofline docs create|update|audit" ;; esac ;;
    explain) [ -n "${2:-}" ] || die "usage: proofline explain <topic|TASK-ID>" ;;
    wiki) case "${2:-}" in ingest|query|lint) ;; *) die "usage: proofline wiki ingest|query|lint" ;; esac ;;
    product) case "${2:-}" in prd|review|split|outcome) [ -n "${3:-}" ] || die "usage: proofline product prd|review|split|outcome <slug>" ;; discover) case "${3:-}" in frame|research|interviews|competitors|opportunities) [ -n "${4:-}" ] || die "usage: proofline product discover frame|research|interviews|competitors|opportunities <slug>" ;; *) die "usage: proofline product discover frame|research|interviews|competitors|opportunities <slug>" ;; esac ;; assess) case "${3:-}" in assumptions|probes|premortem|redteam|decision) [ -n "${4:-}" ] || die "usage: proofline product assess assumptions|probes|premortem|redteam|decision <slug>" ;; *) die "usage: proofline product assess assumptions|probes|premortem|redteam|decision <slug>" ;; esac ;; *) die "usage: proofline product prd|review|split|outcome|discover|assess ... <slug>" ;; esac ;;
    trace) [ -n "${2:-}" ] || die "usage: proofline trace <FR-n|TASK-ID>" ;;
  esac
  require_installed
  shift
  hint "$c" "$@"
}

main() {
  cmd=${1:-status}
  [ $# -eq 0 ] || shift
  PL_CMD=$cmd
  case "$cmd" in --version|-v) PL_CMD=version ;; --help|-h) PL_CMD=help ;; deliver|run|knowledge|reopen) PL_ID=${1:-} ;; esac
  nu_json=no; case " $* " in *" --json "*) nu_json=yes ;; esac   # machine-readable output carries no extra line
  rc=0; dispatch "$cmd" "$@" || rc=$?
  if [ "$rc" != 0 ]; then nu_line --error >&2 || :
  elif [ "$nu_json" = no ]; then case "$PL_CMD" in init|upgrade|doctor|status|resume|queue|debt|clean|merge|insights) nu_line || : ;; esac; fi
  exit "$rc"
}

dispatch() {
  cmd=$1; shift
  case "$cmd" in
    init) cmd_init "$@" ;;
    upgrade) cmd_upgrade "$@" ;;
    doctor) cmd_doctor "$@" ;;
    status) cmd_status ;;
    resume) cmd_resume ;;
    queue) cmd_queue ;;
    deliver) cmd_deliver "$@" ;;
    debt) cmd_debt ;;
    clean) cmd_clean "$@" ;;
    merge) cmd_merge "$@" ;;
    insights) cmd_insights "$@" ;;
    task) cmd_task "$@" ;;
    design) cmd_design "$@" ;;
    run) cmd_run "$@" ;;
    batch) cmd_batch "$@" ;;
    review|audit|debug|docs|explain|wiki|product|trace) cmd_session "$cmd" "$@" ;;
    version|--version|-v) say "proofline $PROOFLINE_VERSION" ;;
    help|--help|-h) usage ;;
    *) usage >&2; PL_CMD=''; PL_KIND=usage; die "unknown command: $cmd" ;;
  esac
}
main "$@"
