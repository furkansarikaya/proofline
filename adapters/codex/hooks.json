{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/.agents/hooks/proofline-hook.mjs\" session codex",
            "timeout": 30
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/.agents/hooks/proofline-hook.mjs\" prompt codex",
            "timeout": 30
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "R=$(git rev-parse --show-toplevel 2>/dev/null); if command -v node >/dev/null 2>&1 && test -f \"$R/.agents/hooks/proofline-hook.mjs\"; then node \"$R/.agents/hooks/proofline-hook.mjs\" pretool codex; rc=$?; test $rc -eq 0 && exit 0; test $rc -eq 2 || echo \"proofline: the hook ended with status $rc; failing closed\" >&2; exit 2; fi; test ! -f \"$R/.agents/config.yaml\" || { echo \"proofline: the hook did not start (node 22.13 or newer must be on PATH, and .agents/hooks/proofline-hook.mjs must exist); failing closed\" >&2; exit 2; }",
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/.agents/hooks/proofline-hook.mjs\" posttool codex",
            "timeout": 30
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/.agents/hooks/proofline-hook.mjs\" subagent-start codex",
            "timeout": 60
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/.agents/hooks/proofline-hook.mjs\" subagent-stop codex",
            "timeout": 120
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/.agents/hooks/proofline-hook.mjs\" stop codex",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
