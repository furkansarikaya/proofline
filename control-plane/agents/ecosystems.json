{
  "$comment": "The single definition of the language ecosystems proofline knows (A173). Every script reads this file: bin/lib/discover.sh (command discovery), skills/verify-proof/scripts/runtime-versions.sh (runtime versions) and, later, the review, dependency, design, visual, performance and TDD checks. Adding an ecosystem is one object in `ecosystems`. Never edit ecosystems.tsv by hand: `node ecosystems.mjs write` regenerates it and `node ecosystems.mjs check` fails when it differs. Shapes are documented in docs/concepts/ecosystems.md. Globs use the dialect of agent.sh (a pattern without / matches at any depth, ** spans directories, * and ? stay inside one segment). Every regular expression is written in the part that POSIX ERE and JavaScript share (no lookarounds, no \\d, \\s, \\w, no [[:classes:]]) and is applied to one line of a file at a time, except where a source says `flatten`. A /source/flags string is a JavaScript regular expression.",
  "schema_version": 1,
  "global": {
    "prune": [
      ".git", ".hg", ".svn", ".agents", ".claude", ".codex", ".proofline",
      "node_modules", "bin", "obj", "build", "dist", "out", "target", "vendor", "artifacts",
      ".venv", "venv", "__pycache__", ".tox", ".mypy_cache", ".pytest_cache", ".ruff_cache",
      ".gradle", ".idea", ".vs", ".vscode", ".cache", "coverage", ".terraform",
      ".next", ".nuxt", ".turbo", ".nx", ".svelte-kit", ".yarn", ".pnpm-store",
      ".dart_tool", ".pub-cache", ".build", ".swiftpm", "Pods", "DerivedData", ".bundle", ".nuget"
    ],
    "limits": {
      "discover_max_markers": "1000",
      "version_scan_depth": "6",
      "version_scan_max_files": "400"
    },
    "risky_paths": [
      ".github/**", ".gitlab-ci.yml", ".circleci/**", "Jenkinsfile", "azure-pipelines.yml", "bitbucket-pipelines.yml",
      "Dockerfile", "**/Dockerfile*", "docker-compose*.yml", "compose*.yml"
    ],
    "ci_scan": {
      "tools": ["make"],
      "build": " (build|compile|package)( |$)",
      "test": " (test|tests|pytest)( |$)|^pytest",
      "lint": " (lint|vet|clippy)( |$)|^(ruff|eslint)"
    }
  },
  "ecosystems": [
    {
      "id": "npm",
      "name": "JavaScript / TypeScript (npm, pnpm, yarn, bun; workspaces, turbo, nx)",
      "prune": [".parcel-cache", ".angular", ".expo", ".docusaurus"],
      "project_files": ["package.json"],
      "manifests": ["package.json"],
      "locks": ["package-lock.json", "npm-shrinkwrap.json", "yarn.lock", "pnpm-lock.yaml", "bun.lockb", "bun.lock"],
      "settings": [".npmrc", ".yarnrc", ".yarnrc.yml", ".pnpmfile.cjs", "bunfig.toml"],
      "workspace_roots": [
        { "file": "pnpm-workspace.yaml" },
        { "file": "package.json", "contains": "\"workspaces\" *:" },
        { "file": "turbo.json" },
        { "file": "nx.json" },
        { "file": "lerna.json" },
        { "file": "rush.json" }
      ],
      "solution_files": [],
      "units": { "target": "dir", "bare": "root", "stages": [], "legacy": [] },
      "runtime": {
        "name": "node",
        "compare": "1",
        "present": ["package.json"],
        "local": { "commands": ["node --version"], "extract": "^v?([0-9][0-9.]*)", "group": "1" }
      },
      "version_files": [
        { "kind": "workflow", "keys": ["node-version"] },
        { "kind": "line", "file": ".nvmrc" },
        { "kind": "line", "file": ".node-version" },
        { "kind": "tool_versions", "names": ["nodejs", "node"] },
        { "kind": "match", "file": "package.json", "flatten": "true", "pattern": "\"engines\" *: *\\{[^}]*\"node\" *: *\"([^\"]*)\"", "group": "1" },
        { "kind": "match", "file": "package.json", "flatten": "true", "pattern": "\"volta\" *: *\\{[^}]*\"node\" *: *\"([^\"]*)\"", "group": "1" },
        { "kind": "gitlab_image", "image": "node" }
      ],
      "risky_paths": ["turbo.json", "nx.json", "lerna.json", "rush.json", "pnpm-workspace.yaml"],
      "commands": {
        "truth": "scripts",
        "tools": ["npm", "pnpm", "yarn", "bun", "eslint"],
        "ci_lint": [],
        "runners": [
          { "when": { "file": "pnpm-lock.yaml" }, "run": "pnpm run", "test": "pnpm test", "at_run": "pnpm --dir {dir} run", "at_test": "pnpm --dir {dir} test" },
          { "when": { "file": "yarn.lock" }, "run": "yarn", "test": "yarn test", "at_run": "yarn --cwd {dir}", "at_test": "yarn --cwd {dir} test" },
          { "when": { "any_file": ["bun.lockb", "bun.lock"] }, "run": "bun run", "test": "bun test", "at_run": "bun --cwd {dir} run", "at_test": "bun --cwd {dir} test" },
          { "run": "npm run", "test": "npm test", "at_run": "npm --prefix {dir} run", "at_test": "npm --prefix {dir} test" }
        ],
        "build": [
          { "when": { "script": "build" }, "run": "{run} build", "at": "{at_run} build" }
        ],
        "test": [
          { "when": { "script": "test", "script_not": "no test specified" }, "run": "{test}", "at": "{at_test}" }
        ],
        "lint": [
          { "when": { "script": "lint" }, "run": "{run} lint", "at": "{at_run} lint" }
        ]
      },
      "benchmark": {
        "scripts": ["bench", "benchmark", "perf*"],
        "dirs": [],
        "files": [],
        "dependencies": [],
        "config_files": []
      },
      "native_ui": [
        { "file": "package.json", "contains": "\"react-native\" *:", "platform": "react-native", "kind": "mobile", "why": "package.json depends on react-native" },
        { "file": "package.json", "contains": "\"electron\" *:", "platform": "electron", "kind": "shell", "why": "package.json depends on electron" },
        { "file": "tauri.conf.json", "platform": "tauri", "kind": "shell", "why": "tauri configuration" },
        { "file": "tauri.conf.json5", "platform": "tauri", "kind": "shell", "why": "tauri configuration" }
      ],
      "test_output": {
        "status": "seed",
        "runners": ["jest", "vitest", "mocha", "node:test"],
        "no_tests": ["/No tests found, exiting with code/", "/No test files found/", "/^\\s*(ℹ|#)\\s*tests\\s+0\\b/m"],
        "compile": ["/error TS\\d+/"],
        "assertion": ["/AssertionError/", "/\\bexpect\\(.*\\)\\.(not\\.)?to\\w+/", "/Expected:[\\s\\S]{0,400}?(Received|Actual):/"],
        "exit_codes": { "no_tests": ["1"], "compile": ["1", "2"], "assertion": ["1"] }
      }
    },
