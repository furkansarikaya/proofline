{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ui-design ui.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "mode", "ui_languages", "design_system", "reused", "new", "screens", "flows"],
  "$defs": {
    "strings": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "visitor_mode": {
      "type": "object", "additionalProperties": false, "required": ["mode", "reason"],
      "properties": { "mode": { "enum": ["persuade", "operate", "read", "experience"] }, "reason": { "type": "string", "minLength": 1 } }
    },
    "state": {
      "oneOf": [
        { "type": "object", "additionalProperties": false, "required": ["copy", "behavior"], "properties": { "copy": { "type": "string", "minLength": 1 }, "behavior": { "type": "string", "minLength": 1 } } },
        { "type": "object", "additionalProperties": false, "required": ["not_applicable"], "properties": { "not_applicable": { "type": "string", "minLength": 1 } } }
      ]
    }
  },
  "properties": {
    "schema_version": { "const": 1 },
    "mode": { "enum": ["task", "reverse"] },
    "target": { "enum": ["web", "ios", "android", "flutter", "react-native"], "default": "web", "description": "keyboard per screen is required for web and optional for native mobile targets" },
    "ui_languages": { "$ref": "#/$defs/strings" },
    "visitor_mode": {
      "$comment": "0.0.27 (A170). Required when creative_direction.basis is new or redesign; validated whenever present. A screen may override with its own visitor_mode (the effective mode of a screen is its own, else this one).",
      "$ref": "#/$defs/visitor_mode"
    },
    "argument": {
      "$comment": "0.0.27. Required when an effective mode is persuade: every persuade screen has at least one row. product-fact: the file under docs/product/ exists (with --root) and ref (an id or heading anchor) is present in it. code: the path exists (with --root).",
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["screen", "section", "claim", "proof"],
        "properties": {
          "screen": { "type": "string", "minLength": 1 }, "section": { "type": "string", "minLength": 1 }, "claim": { "type": "string", "minLength": 1 },
          "proof": {
            "oneOf": [
              { "type": "object", "additionalProperties": false, "required": ["kind", "file", "ref"], "properties": { "kind": { "const": "product-fact" }, "file": { "type": "string", "minLength": 1 }, "ref": { "type": "string", "minLength": 1 } } },
              { "type": "object", "additionalProperties": false, "required": ["kind", "path"], "properties": { "kind": { "const": "code" }, "path": { "type": "string", "minLength": 1 } } }
            ]
          }
        }
      }
    },
    "craft": {
      "$comment": "0.0.27. Required for a persuade surface (live_thing, visual_plan, motion, fonts); validated whenever present.",
      "type": "object", "additionalProperties": false,
      "properties": {
        "live_thing": { "type": "object", "additionalProperties": false, "required": ["description", "phone_ok", "no_script_fallback", "does_not_block_reading"], "properties": { "description": { "type": "string", "minLength": 1 }, "phone_ok": { "const": true }, "no_script_fallback": { "type": "string", "minLength": 1 }, "does_not_block_reading": { "const": true } } },
        "visual_plan": { "type": "object", "additionalProperties": false, "required": ["real", "images", "ledger"], "properties": { "real": { "$ref": "#/$defs/strings" }, "images": { "type": "array", "items": { "type": "string", "minLength": 1 } }, "ledger": { "type": "string", "minLength": 1 } } },
        "motion": { "type": "object", "additionalProperties": false, "required": ["thesis", "signature", "stagger_ms", "feedback_all_controls", "moving_visual", "reduced_motion"], "properties": { "thesis": { "type": "string", "minLength": 1 }, "signature": { "type": "string", "minLength": 1 }, "stagger_ms": { "type": "number", "minimum": 60, "maximum": 90 }, "feedback_all_controls": { "const": true }, "moving_visual": { "type": "string", "minLength": 1 }, "reduced_motion": { "type": "string", "minLength": 1 } } },
        "fonts": { "type": "array", "minItems": 1, "items": { "type": "object", "additionalProperties": false, "required": ["family", "file", "license"], "properties": { "family": { "type": "string", "minLength": 1 }, "file": { "type": "string", "minLength": 1 }, "license": { "type": "string", "minLength": 1 } } } }
      }
    },
    "design_system": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file", "exists"],
      "properties": { "file": { "type": "string", "minLength": 1 }, "exists": { "type": "boolean" } }
    },
    "reused": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false, "required": ["kind", "name", "path"],
        "properties": { "kind": { "enum": ["token", "component"] }, "name": { "type": "string", "minLength": 1 }, "path": { "type": "string", "minLength": 1 } }
      }
    },
    "new": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false, "required": ["kind", "name", "reason", "reuse_rejected"],
        "properties": {
          "kind": { "enum": ["token", "component", "variant"] },
          "name": { "type": "string", "minLength": 1 },
          "reason": { "type": "string", "minLength": 1 },
          "reuse_rejected": { "type": "string", "minLength": 1 },
          "base": { "type": "string" }
        }
      }
    },
    "screens": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "name", "states", "screen_reader", "responsive"],
        "properties": {
          "id": { "type": "string", "pattern": "^S[0-9]+$" },
          "name": { "type": "string", "minLength": 1 },
          "route": { "type": "string" },
          "states": {
            "type": "object", "additionalProperties": false,
            "required": ["empty", "loading", "error", "success", "partial", "permission-denied"],
            "properties": {
              "empty": { "$ref": "#/$defs/state" }, "loading": { "$ref": "#/$defs/state" }, "error": { "$ref": "#/$defs/state" },
              "success": { "$ref": "#/$defs/state" }, "partial": { "$ref": "#/$defs/state" }, "permission-denied": { "$ref": "#/$defs/state" }
            }
          },
          "visitor_mode": { "$ref": "#/$defs/visitor_mode" },
          "first_screen": {
            "$comment": "Required on persuade and experience screens: headline at most 48 characters (aim near 32), one plain sentence under it, exactly one primary action named after what it does.",
            "type": "object", "additionalProperties": false, "required": ["headline", "subline", "primary_actions"],
            "properties": {
              "headline": { "type": "string", "minLength": 1, "maxLength": 48 }, "subline": { "type": "string", "minLength": 1 },
              "primary_actions": { "type": "array", "minItems": 1, "maxItems": 1, "items": { "type": "string", "minLength": 1 } }
            }
          },
          "keyboard": { "$ref": "#/$defs/strings" },
          "screen_reader": { "$ref": "#/$defs/strings" },
          "responsive": { "$ref": "#/$defs/strings" }
        }
      }
    },
    "flows": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false, "required": ["id", "name", "steps", "screens"],
        "properties": {
          "id": { "type": "string", "minLength": 1 }, "name": { "type": "string", "minLength": 1 },
          "steps": { "$ref": "#/$defs/strings" }, "screens": { "$ref": "#/$defs/strings" }
        }
      }
    },
    "creative_direction": {
      "$comment": "A81. Optional; required for COMPLEX/CRITICAL in mode task (validator --class/--task). basis new is invalid when design_system.exists; basis redesign needs redesign.task_quote (found in TASK.md) and redesign.user_approval; basis new needs avoided. basis new|redesign needs alternatives (2-3, unique names) and chosen (one alternative name); conform rejects both. redesign with design_system.exists false needs redesign.inventory and avoided, and user_approval is then optional (the user's request is the approval).",
      "type": "object", "additionalProperties": false,
      "required": ["basis", "visual_character", "typography", "layout", "hierarchy", "rationale"],
      "properties": {
        "basis": { "enum": ["conform", "redesign", "new"] },
        "visual_character": { "type": "string", "minLength": 1 },
        "typography": { "type": "string", "minLength": 1 },
        "layout": { "type": "string", "minLength": 1 },
        "hierarchy": { "type": "string", "minLength": 1 },
        "rationale": { "type": "string", "minLength": 1 },
        "avoided": { "$ref": "#/$defs/strings" },
        "alternatives": {
          "$comment": "2-3 items; with a persuade or experience surface and basis new|redesign exactly 4: the three dealt candidates plus the standard option (standard: true, named as deal.standard, never recommended).",
          "type": "array", "minItems": 2, "maxItems": 4,
          "items": {
            "type": "object", "additionalProperties": false, "required": ["name", "summary", "trade_off"],
            "properties": { "name": { "type": "string", "minLength": 1 }, "summary": { "type": "string", "minLength": 1 }, "trade_off": { "type": "string", "minLength": 1 }, "standard": { "type": "boolean" } }
          }
        },
        "topic_inventory": { "type": "array", "minItems": 8, "maxItems": 12, "items": { "type": "string", "minLength": 1 } },
        "idea": {
          "$comment": "'On this page, <inventory item> becomes <tool>.' plus the rival test: with the nearest rival's name in the sentence it must no longer hold.",
          "type": "object", "additionalProperties": false, "required": ["sentence", "rival", "rival_swap", "note"],
          "properties": { "sentence": { "type": "string", "minLength": 1 }, "rival": { "type": "string", "minLength": 1 }, "rival_swap": { "const": "no_longer_true" }, "note": { "type": "string", "minLength": 1 } }
        },
        "candidates": {
          "type": "array", "minItems": 5, "maxItems": 7,
          "items": {
            "type": "object", "additionalProperties": false, "required": ["name", "composition", "colour_strategy", "type_voice", "visual_mode", "signature_motion", "first_screen"],
            "properties": {
              "name": { "type": "string", "minLength": 1 }, "composition": { "type": "string", "minLength": 1 },
              "colour_strategy": { "enum": ["restrained", "committed", "full-palette", "drenched"] },
              "type_voice": { "type": "string", "minLength": 1 }, "visual_mode": { "type": "string", "minLength": 1 },
              "signature_motion": { "type": "string", "minLength": 1 }, "first_screen": { "type": "string", "minLength": 1 }
            }
          }
        },
        "deal": {
          "$comment": "Output of scripts/deal.mjs; the validator re-deals with the seed and rejects a mismatch.",
          "type": "object", "additionalProperties": false, "required": ["seed", "dealt", "standard"],
          "properties": { "seed": { "type": "integer", "minimum": 0, "maximum": 4294967295 }, "dealt": { "type": "array", "minItems": 3, "maxItems": 3, "items": { "type": "string", "minLength": 1 } }, "standard": { "type": "string", "minLength": 1 } }
        },
        "patterns_used": {
          "$comment": "Registry patterns (references/PATTERNS.md) used on purpose, each with a reason. Unknown ids are rejected.",
          "type": "array",
          "items": {
            "type": "object", "additionalProperties": false, "required": ["id", "reason"],
            "properties": {
              "id": { "enum": ["cream-serif-terracotta", "dark-single-neon-glow", "hairline-newspaper", "uniform-saas-cards", "eyebrow-label", "mono-labels", "numbered-steps", "middot-meta", "gradient-text", "decorative-glass", "side-stripe-card", "hard-offset-shadow", "emoji-icons", "sketch-svg", "grid-background"] },
              "reason": { "type": "string", "minLength": 1 }
            }
          }
        },
        "chosen": { "type": "string", "minLength": 1 },
        "redesign": {
          "type": "object", "additionalProperties": false, "required": ["task_quote"],
          "properties": { "task_quote": { "type": "string", "minLength": 1 }, "user_approval": { "type": "string", "minLength": 1 }, "inventory": { "$ref": "#/$defs/strings" } }
        }
      }
    },
    "ux_patterns": {
      "$comment": "A81. chosen must be one of options.",
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["decision", "options", "chosen", "density", "flow", "rationale"],
        "properties": {
          "decision": { "type": "string", "minLength": 1 },
          "options": { "type": "array", "minItems": 2, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
          "chosen": { "type": "string", "minLength": 1 },
          "density": { "type": "string", "minLength": 1 },
          "flow": { "type": "string", "minLength": 1 },
          "rationale": { "type": "string", "minLength": 1 }
        }
      }
    },
    "self_critique": {
      "$comment": "A81. Never an approval: approval wording in the passes or checks is rejected (the designer never gives final quality approval of its own design).",
      "type": "object", "additionalProperties": false, "required": ["hierarchy", "density", "consistency", "legibility", "anti_patterns"],
      "properties": {
        "hierarchy": { "type": "string", "minLength": 1 },
        "density": { "type": "string", "minLength": 1 },
        "consistency": { "type": "string", "minLength": 1 },
        "legibility": { "type": "string", "minLength": 1 },
        "anti_patterns": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object", "additionalProperties": false, "required": ["check", "result"],
            "properties": { "check": { "type": "string", "minLength": 1 }, "result": { "enum": ["clear", "fixed", "accepted"] }, "note": { "type": "string" } }
          }
        }
      }
    },
    "criteria": {
      "$comment": "A81. One entry per UI-facing acceptance criterion. visual_proof required = needs visual evidence; ids must be TASK criteria (validator --task). Listed by validate-ui.mjs --list-visual-proof.",
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["id", "screens", "visual_proof"],
        "properties": {
          "id": { "type": "string", "pattern": "^AC-[0-9]+$" },
          "screens": { "$ref": "#/$defs/strings" },
          "visual_proof": { "enum": ["required", "not_required"] },
          "evidence": { "type": "string" }
        }
      }
    }
  }
}
