{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ui-design ui.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "mode", "ui_languages", "design_system", "reused", "new", "screens", "flows"],
  "$defs": {
    "strings": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "state": {
      "oneOf": [
        { "type": "object", "additionalProperties": false, "required": ["copy", "behavior"], "properties": { "copy": { "type": "string", "minLength": 1 }, "behavior": { "type": "string", "minLength": 1 } } },
        { "type": "object", "additionalProperties": false, "required": ["not_applicable"], "properties": { "not_applicable": { "type": "string", "minLength": 1 } } }
      ]
    }
  },
  "properties": {
    "schema_version": { "const": 1 },
    "mode": { "enum": ["task", "reverse"] },
    "ui_languages": { "$ref": "#/$defs/strings" },
    "design_system": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file", "exists"],
      "properties": { "file": { "type": "string", "minLength": 1 }, "exists": { "type": "boolean" } }
    },
    "reused": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false, "required": ["kind", "name", "path"],
        "properties": { "kind": { "enum": ["token", "component"] }, "name": { "type": "string", "minLength": 1 }, "path": { "type": "string", "minLength": 1 } }
      }
    },
    "new": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false, "required": ["kind", "name", "reason", "reuse_rejected"],
        "properties": {
          "kind": { "enum": ["token", "component", "variant"] },
          "name": { "type": "string", "minLength": 1 },
          "reason": { "type": "string", "minLength": 1 },
          "reuse_rejected": { "type": "string", "minLength": 1 },
          "base": { "type": "string" }
        }
      }
    },
    "screens": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "name", "states", "keyboard", "screen_reader", "responsive"],
        "properties": {
          "id": { "type": "string", "pattern": "^S[0-9]+$" },
          "name": { "type": "string", "minLength": 1 },
          "route": { "type": "string" },
          "states": {
            "type": "object", "additionalProperties": false,
            "required": ["empty", "loading", "error", "success", "partial", "permission-denied"],
            "properties": {
              "empty": { "$ref": "#/$defs/state" }, "loading": { "$ref": "#/$defs/state" }, "error": { "$ref": "#/$defs/state" },
              "success": { "$ref": "#/$defs/state" }, "partial": { "$ref": "#/$defs/state" }, "permission-denied": { "$ref": "#/$defs/state" }
            }
          },
          "keyboard": { "$ref": "#/$defs/strings" },
          "screen_reader": { "$ref": "#/$defs/strings" },
          "responsive": { "$ref": "#/$defs/strings" }
        }
      }
    },
    "flows": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false, "required": ["id", "name", "steps", "screens"],
        "properties": {
          "id": { "type": "string", "minLength": 1 }, "name": { "type": "string", "minLength": 1 },
          "steps": { "$ref": "#/$defs/strings" }, "screens": { "$ref": "#/$defs/strings" }
        }
      }
    },
    "creative_direction": {
      "$comment": "A81. Optional; required for COMPLEX/CRITICAL in mode task (validator --class/--task). basis new is invalid when design_system.exists; basis redesign needs redesign.task_quote (found in TASK.md) and redesign.user_approval; basis new needs avoided.",
      "type": "object", "additionalProperties": false,
      "required": ["basis", "visual_character", "typography", "layout", "hierarchy", "rationale"],
      "properties": {
        "basis": { "enum": ["conform", "redesign", "new"] },
        "visual_character": { "type": "string", "minLength": 1 },
        "typography": { "type": "string", "minLength": 1 },
        "layout": { "type": "string", "minLength": 1 },
        "hierarchy": { "type": "string", "minLength": 1 },
        "rationale": { "type": "string", "minLength": 1 },
        "avoided": { "$ref": "#/$defs/strings" },
        "redesign": {
          "type": "object", "additionalProperties": false, "required": ["task_quote", "user_approval"],
          "properties": { "task_quote": { "type": "string", "minLength": 1 }, "user_approval": { "type": "string", "minLength": 1 } }
        }
      }
    },
    "ux_patterns": {
      "$comment": "A81. chosen must be one of options.",
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["decision", "options", "chosen", "density", "flow", "rationale"],
        "properties": {
          "decision": { "type": "string", "minLength": 1 },
          "options": { "type": "array", "minItems": 2, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
          "chosen": { "type": "string", "minLength": 1 },
          "density": { "type": "string", "minLength": 1 },
          "flow": { "type": "string", "minLength": 1 },
          "rationale": { "type": "string", "minLength": 1 }
        }
      }
    },
    "self_critique": {
      "$comment": "A81. Never an approval: approval wording in the passes or checks is rejected (the designer never gives final quality approval of its own design).",
      "type": "object", "additionalProperties": false, "required": ["hierarchy", "density", "consistency", "legibility", "anti_patterns"],
      "properties": {
        "hierarchy": { "type": "string", "minLength": 1 },
        "density": { "type": "string", "minLength": 1 },
        "consistency": { "type": "string", "minLength": 1 },
        "legibility": { "type": "string", "minLength": 1 },
        "anti_patterns": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object", "additionalProperties": false, "required": ["check", "result"],
            "properties": { "check": { "type": "string", "minLength": 1 }, "result": { "enum": ["clear", "fixed", "accepted"] }, "note": { "type": "string" } }
          }
        }
      }
    },
    "criteria": {
      "$comment": "A81. One entry per UI-facing acceptance criterion. visual_proof required = needs visual evidence; ids must be TASK criteria (validator --task). Listed by validate-ui.mjs --list-visual-proof.",
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["id", "screens", "visual_proof"],
        "properties": {
          "id": { "type": "string", "pattern": "^AC-[0-9]+$" },
          "screens": { "$ref": "#/$defs/strings" },
          "visual_proof": { "enum": ["required", "not_required"] },
          "evidence": { "type": "string" }
        }
      }
    }
  }
}
