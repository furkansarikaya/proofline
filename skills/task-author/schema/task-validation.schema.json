{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "validate-task.mjs --json output",
  "type": "object",
  "required": ["valid", "errors", "warnings", "task"],
  "additionalProperties": false,
  "properties": {
    "valid": { "type": "boolean" },
    "errors": { "type": "array", "items": { "type": "string" } },
    "warnings": { "type": "array", "items": { "type": "string" } },
    "task": {
      "type": "object",
      "required": ["acs"],
      "properties": {
        "id": { "type": ["string", "null"] },
        "title": { "type": ["string", "null"] },
        "acs": { "type": "integer", "minimum": 0 },
        "class": { "enum": ["TRIVIAL", "STANDARD", "COMPLEX", "CRITICAL", null] },
        "type": { "enum": ["feature", "bug", "refactor", "content", "docs", "chore"], "description": "the task type; a task without a type is a feature" },
        "meta": {
          "type": "object",
          "description": "optional front matter, present only when the task has one",
          "properties": {
            "type": { "type": "string", "description": "task type: feature, bug, refactor, content, docs or chore (A202)" },
            "size": { "enum": ["S", "M", "L"] },
            "sprint": { "type": "string" },
            "assignee": { "type": "string" },
            "depends_on": { "type": "string" },
            "prd": { "type": "string", "description": "slug of the PRD the Covers ids refer to (product-spec)" },
            "priority": { "enum": ["high", "medium", "low"], "description": "orders a night batch among tasks without dependencies (A202)" },
            "origin": { "type": "string", "description": "the source task id, or prd:<slug> (A202)" }
          }
        },
        "covers": {
          "type": "object",
          "description": "optional, present only when a criterion ends with `Covers: FR-n, NFR-n`: criterion id -> requirement ids",
          "additionalProperties": { "type": "array", "items": { "type": "string", "pattern": "^N?FR-[0-9]+$" } }
        }
      }
    }
  }
}
