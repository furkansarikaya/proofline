{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/furkansarikaya/proofline/skills/proof-review/schema/findings.schema.json",
  "title": "proof-review findings.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "skill_version",
    "generated_at",
    "target",
    "scope",
    "claims",
    "rules",
    "unrequested",
    "bugs",
    "suspicions"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "skill_version": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "name",
        "slug",
        "base",
        "head"
      ],
      "properties": {
        "type": {
          "enum": [
            "working_tree",
            "branch",
            "pr"
          ]
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "slug": {
          "type": "string",
          "pattern": "^(?!\\.)[A-Za-z0-9._-]+$"
        },
        "base": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "head": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "pattern": "\\S"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "working_tree"
              }
            }
          },
          "then": {
            "properties": {
              "head": {
                "type": "null"
              },
              "slug": {
                "const": "working-tree"
              }
            }
          },
          "else": {
            "properties": {
              "head": {
                "type": "string"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "pr"
              }
            }
          },
          "then": {
            "properties": {
              "slug": {
                "pattern": "^pr-[0-9]+$"
              }
            }
          }
        }
      ]
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "changed_files",
        "changed_lines",
        "excluded",
        "not_reviewed",
        "rule_files_read",
        "rule_files_not_read"
      ],
      "properties": {
        "changed_files": {
          "type": "integer",
          "minimum": 0
        },
        "changed_lines": {
          "type": "integer",
          "minimum": 0
        },
        "excluded": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        },
        "rule_files_read": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        },
        "rule_files_not_read": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        },
        "not_reviewed": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "reason"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "reason": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              }
            }
          }
        }
      }
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "text",
          "source",
          "status",
          "locations"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^C\\d{3}$"
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "source": {
            "enum": [
              "user",
              "pr_description",
              "issue",
              "commit",
              "plan"
            ]
          },
          "status": {
            "enum": [
              "done",
              "partial",
              "missing"
            ]
          },
          "locations": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/location"
            }
          },
          "missing_part": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "criterion": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S",
            "description": "Acceptance criterion id from the plan or task (for example AC-1). Required when source is plan, forbidden otherwise."
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "const": "partial"
                }
              }
            },
            "then": {
              "required": [
                "missing_part"
              ]
            },
            "else": {
              "not": {
                "required": [
                  "missing_part"
                ]
              }
            }
          },
          {
            "if": {
              "properties": {
                "status": {
                  "enum": [
                    "done",
                    "partial"
                  ]
                }
              }
            },
            "then": {
              "properties": {
                "locations": {
                  "minItems": 1
                }
              }
            }
          }
        ]
      }
    },
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "rule",
          "source",
          "location",
          "violation"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^R\\d{3}$"
          },
          "rule": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "source": {
            "$ref": "#/$defs/location"
          },
          "location": {
            "$ref": "#/$defs/location"
          },
          "violation": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        }
      }
    },
    "unrequested": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "files",
          "description"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^U\\d{3}$"
          },
          "files": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "blocking": {
            "const": true,
            "description": "Inside a proofline run only: a hunk in the plan scope that changes behaviour and ties to no acceptance criterion (A153). Fails the gate. Absent for informational records."
          }
        }
      }
    },
    "bugs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "evidence",
          "location",
          "input",
          "expected",
          "actual",
          "impact",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^F\\d{3}$"
          },
          "evidence": {
            "enum": [
              "reproduced",
              "traced"
            ]
          },
          "location": {
            "$ref": "#/$defs/location"
          },
          "input": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "expected": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "actual": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "impact": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "reproduction": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "file",
              "command",
              "output"
            ],
            "properties": {
              "file": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "command": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "output": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "source": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S",
                "description": "Full text of the reproduction file. Required when evidence_pruned, so the fix brief and a re-run survive the deletion of evidence/."
              }
            }
          },
          "trace": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          },
          "status": {
            "enum": [
              "open",
              "fixed"
            ]
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "evidence": {
                  "const": "reproduced"
                }
              }
            },
            "then": {
              "required": [
                "reproduction"
              ],
              "not": {
                "required": [
                  "trace"
                ]
              }
            },
            "else": {
              "required": [
                "trace"
              ],
              "not": {
                "required": [
                  "reproduction"
                ]
              }
            }
          }
        ]
      }
    },
    "suspicions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "location",
          "reason",
          "why_unproven"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^S\\d{3}$"
          },
          "location": {
            "$ref": "#/$defs/location"
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "why_unproven": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        }
      }
    },
    "focus": {
      "enum": [
        "plan",
        "rules",
        "bugs",
        "rules+bugs",
        "rules+tests",
        "config",
        "all"
      ],
      "description": "Review focus. Omitted outside a run (means all). A focus may not report the series of another focus; scripts/validate-findings.mjs checks it."
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task"
      ],
      "properties": {
        "task": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      },
      "description": "Present only inside a proofline run. Then focus, gate and fingerprint are required, every claim has source plan, and plan_deviations is required for focus plan and all."
    },
    "fingerprint": {
      "type": "string",
      "pattern": "^[0-9a-f]{40,64}$",
      "description": "Content tree id evaluated (same value as the FINGERPRINT result header)."
    },
    "evidence_pruned": {
      "type": "boolean",
      "description": "true after the raw evidence was deleted; cited paths are history, and reproduced bugs carry reproduction.source."
    },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "result",
        "failing"
      ],
      "description": "Computed by the rule in SKILL.md and recomputed by the validator: any partial or missing claim, open reproduced or traced bug, rule violation or plan deviation fails.",
      "properties": {
        "result": {
          "enum": [
            "PASS",
            "FAIL"
          ]
        },
        "failing": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "plan_deviations": {
      "type": "array",
      "description": "In-run plan checks. A new dependency, or a change to a versioned contract, that PLAN.md does not name.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "subject",
          "location",
          "description"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^P\\d{3}$"
          },
          "kind": {
            "enum": [
              "new_dependency",
              "contract_change"
            ]
          },
          "subject": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S",
            "description": "The package, or the contract and its version."
          },
          "location": {
            "$ref": "#/$defs/location"
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        }
      }
    }
  },
  "$defs": {
    "location": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "file",
        "line"
      ],
      "properties": {
        "file": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "line": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  }
}
