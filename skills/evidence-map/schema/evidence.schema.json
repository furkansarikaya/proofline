{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/furkansarikaya/proofline/skills/evidence-map/schema/evidence.schema.json",
  "title": "evidence-map document (parsed form)",
  "description": "The structure verify-claims.mjs reads from an Explorer result or a consolidated EVIDENCE.md. Claim verification against the repository is in references/VERIFY.md.",
  "type": "object",
  "required": ["kind", "claims", "not_found", "open_questions"],
  "additionalProperties": false,
  "properties": {
    "kind": { "enum": ["explorer", "consolidated"] },
    "assignment": {
      "type": "object",
      "required": ["objective", "allowed_scope", "expected_output", "stop_condition"],
      "additionalProperties": false,
      "properties": {
        "objective": { "type": "string", "minLength": 1 },
        "allowed_scope": { "type": "string", "minLength": 1 },
        "expected_output": { "type": "string", "minLength": 1 },
        "stop_condition": { "type": "string", "minLength": 1 }
      }
    },
    "base_sha": { "type": "string", "pattern": "^[0-9a-f]{7,64}$" },
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "severity", "claim", "category", "finding", "evidence"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^(explorer|E)-\\d+$" },
          "severity": { "enum": ["info", "blocking"] },
          "claim": { "type": "string", "pattern": "^[^\\s:`]+:([0-9]+(-[0-9]+)?|[A-Za-z_$][\\w$]*((\\.|#|::)[A-Za-z_$][\\w$]*)*)$" },
          "category": { "enum": ["code", "test", "pattern", "dependency", "constraint", "affected", "risk", "conflict"] },
          "finding": { "type": "string", "minLength": 1 },
          "evidence": { "type": "string", "minLength": 1 }
        }
      }
    },
    "not_found": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["category", "reason"],
        "additionalProperties": false,
        "properties": {
          "category": { "enum": ["code", "test", "pattern", "dependency", "constraint", "affected", "risk", "conflict"] },
          "reason": { "type": "string", "minLength": 1 }
        }
      }
    },
    "open_questions": { "type": "array", "items": { "type": "string" } },
    "assumptions": {
      "description": "A79: the consolidated document's `## Assumptions` register (consolidated kind only; an empty array is the literal `none`). `accepted-by-user` is never written here: the run records the user's answer.",
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "assumption", "source", "risk", "verification", "status", "decisions"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^AS-\\d+$" },
          "assumption": { "type": "string", "minLength": 1 },
          "source": { "type": "string", "minLength": 1 },
          "risk": { "enum": ["low", "medium", "high"] },
          "verification": { "type": "string" },
          "status": { "enum": ["verified", "unverified"] },
          "decisions": { "type": "string", "minLength": 1 }
        }
      }
    },
    "stop_reason": { "enum": ["objective met", "stop condition reached", "scope exhausted"] }
  }
}
